-- ==================== OLD SHIFT ====================
local oldShiftOn, oldShiftConn, offsetActive = false, nil, false
local currentHumanoid = nil

local function oldShiftLoop()
    if not currentHumanoid then return end
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        if not offsetActive then
            offsetActive = true
            currentHumanoid.CameraOffset = Vector3.new(1.2, 0.8, 0)
        end
    elseif offsetActive then
        offsetActive = false
        currentHumanoid.CameraOffset = Vector3.new(0, 0, 0)
    end
end

local function attachOldShift()
    if oldShiftConn then oldShiftConn:Disconnect() end
    oldShiftConn = RunService.RenderStepped:Connect(oldShiftLoop)
end

local function bindChar(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        currentHumanoid = hum
        hum.CameraOffset = Vector3.new(0, 0, 0)
        offsetActive = false
    end
    if oldShiftOn then
        task.wait(0.1); attachOldShift()
    end
end

LocalPlayer.CharacterAdded:Connect(bindChar)
if LocalPlayer.Character then
    local h = LocalPlayer.Character:WaitForChild("Humanoid", 5)
    if h then currentHumanoid = h end
end

btnOldShift.MouseButton1Click:Connect(function()
    oldShiftOn = not oldShiftOn
    if oldShiftOn then attachOldShift()
    else
        if oldShiftConn then oldShiftConn:Disconnect(); oldShiftConn = nil end
        if currentHumanoid then currentHumanoid.CameraOffset = Vector3.new(0, 0, 0) end
        offsetActive = false
    end
    setOldShift(oldShiftOn, "Old Shift: " .. (oldShiftOn and "Ativado" or "Desativado"))
end)

-- ==================== CAMERA OLD ====================
local camOldOn, camOldConn = false, nil
local function camOldLoop()
    local cam = Workspace.CurrentCamera
    if cam then
        local diff = (cam.Focus.Position - cam.CFrame.Position).Magnitude
        if diff >= 1 then
            cam.CFrame = cam.CFrame + Vector3.new(0, 0.3, 0)
        end
    end
end

btnCameraOld.MouseButton1Click:Connect(function()
    camOldOn = not camOldOn
    if camOldOn then
        if camOldConn then camOldConn:Disconnect() end
        camOldConn = RunService.RenderStepped:Connect(camOldLoop)
    else
        if camOldConn then camOldConn:Disconnect(); camOldConn = nil end
    end
    setCamOld(camOldOn, "Camera Old: " .. (camOldOn and "Ativado" or "Desativado"))
end)

LocalPlayer.CharacterAdded:Connect(function()
    if camOldOn then
        if camOldConn then camOldConn:Disconnect() end
        camOldConn = RunService.RenderStepped:Connect(camOldLoop)
    end
end)

-- ==================== CONFETE ====================
local confeteOn = false
local function simulateLag()
    if confeteOn and NetworkSettings then
        pcall(function()
            NetworkSettings.IncomingReplicationLag = 5
            NetworkSettings.OutgoingReplicationLag = 5
        end)
        task.delay(1.5, function()
            if confeteOn and NetworkSettings then
                pcall(function()
                    NetworkSettings.IncomingReplicationLag = 0
                    NetworkSettings.OutgoingReplicationLag = 0
                end)
            end
        end)
    end
end

local function monitorChar(char)
    local h = char:WaitForChild("Humanoid", 5)
    if h then h.Died:Connect(simulateLag) end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p.Character then
        local h = p.Character:FindFirstChild("Humanoid")
        if h then h.Died:Connect(simulateLag) end
    end
    p.CharacterAdded:Connect(monitorChar)
end
Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(monitorChar) end)

local function toggleConfete()
    confeteOn = not confeteOn
    setConfete(confeteOn, "Confete: " .. (confeteOn and "Ativado" or "Desativado"))
    if not confeteOn and NetworkSettings then
        pcall(function()
            NetworkSettings.IncomingReplicationLag = 0
            NetworkSettings.OutgoingReplicationLag = 0
        end)
    end
end

btnConfete.MouseButton1Click:Connect(toggleConfete)
UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.Y then toggleConfete() end
end)

