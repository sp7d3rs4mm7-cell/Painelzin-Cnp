-- Botão toggle moderno
local function makeToggle(parent, label, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 46)
    btn.BackgroundColor3 = T.Card
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.Parent = parent
    corner(btn, 10)
    local stk = addStroke(btn, T.Stroke, 1, 0.6)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -36, 1, 0)
    txt.Position = UDim2.new(0, 16, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Text = label
    txt.TextColor3 = T.Text
    txt.Font = Enum.Font.GothamMedium
    txt.TextSize = 13
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.TextTruncate = Enum.TextTruncate.AtEnd
    txt.Parent = btn

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 9, 0, 9)
    dot.Position = UDim2.new(1, -22, 0.5, -4)
    dot.BackgroundColor3 = T.TextDim
    dot.BorderSizePixel = 0
    dot.Parent = btn
    corner(dot, 5)

    btn.MouseEnter:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = T.CardHi}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = T.Card}):Play()
        end
    end)

    local function setActive(active, newText)
        btn:SetAttribute("Active", active)
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = active and T.Accent or T.Card
        }):Play()
        TweenService:Create(dot, TweenInfo.new(0.2), {
            BackgroundColor3 = active and T.Success or T.TextDim
        }):Play()
        stk.Transparency = active and 0.1 or 0.6
        if newText then txt.Text = newText end
    end

    return btn, setActive
end

