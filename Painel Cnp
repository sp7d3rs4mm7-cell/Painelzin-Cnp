-- ==================== ANTI-LAG ====================
local antiLagOn = false
local savedProps = {}
local originalLighting = {
    GlobalShadows = Lighting.GlobalShadows,
    EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
    EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
}
local originalQuality = nil
pcall(function() originalQuality = settings().Rendering.QualityLevel end)

local function saveProp(obj)
    if savedProps[obj] then return end
    if obj:IsA("BasePart") then
        savedProps[obj] = {t="part", m=obj.Material, r=obj.Reflectance, c=obj.CastShadow}
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        savedProps[obj] = {t="fx", e=obj.Enabled}
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        savedProps[obj] = {t="tex", tr=obj.Transparency}
    elseif obj:IsA("PostEffect") then
        savedProps[obj] = {t="pe", e=obj.Enabled}
    end
end

local function applyAntiLag(obj)
    saveProp(obj)
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        obj.CastShadow = false
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        obj.Enabled = false
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1
    elseif obj:IsA("SurfaceAppearance") then
        obj:Destroy()
    elseif obj:IsA("PostEffect") then
        obj.Enabled = false
    end
end

local function restoreAntiLag()
    for obj, p in pairs(savedProps) do
        if obj and obj.Parent then
            if p.t == "part" then
                obj.Material = p.m; obj.Reflectance = p.r; obj.CastShadow = p.c
            elseif p.t == "fx" or p.t == "pe" then
                obj.Enabled = p.e
            elseif p.t == "tex" then
                obj.Transparency = p.tr
            end
        end
    end
    Lighting.GlobalShadows = originalLighting.GlobalShadows
    Lighting.EnvironmentDiffuseScale = originalLighting.EnvironmentDiffuseScale
    Lighting.EnvironmentSpecularScale = originalLighting.EnvironmentSpecularScale
    if originalQuality then
        pcall(function() settings().Rendering.QualityLevel = originalQuality end)
    end
end

btnAntiLag.MouseButton1Click:Connect(function()
    antiLagOn = not antiLagOn
    if antiLagOn then
        for _, d in ipairs(Workspace:GetDescendants()) do applyAntiLag(d) end
        for _, d in ipairs(Lighting:GetDescendants()) do applyAntiLag(d) end
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        setAntiLag(true, "Anti-Lag: Ativado")
    else
        restoreAntiLag()
        setAntiLag(false, "Anti-Lag: Desativado")
    end
end)

Workspace.DescendantAdded:Connect(function(obj)
    if antiLagOn then
        task.defer(function() if obj and obj.Parent then applyAntiLag(obj) end end)
    end
end)
Lighting.DescendantAdded:Connect(function(obj)
    if antiLagOn then
        task.defer(function() if obj and obj.Parent then applyAntiLag(obj) end end)
    end
end)

