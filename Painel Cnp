local savedCF = {}, origCF = {}

local function getTool()
    local c = LocalPlayer.Character
    if not c then return nil end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
end

local function getGrip()
    local c = LocalPlayer.Character
    if not c then return nil end
    local rh = c:FindFirstChild("RightHand")
    if not rh then return nil end
    local g = rh:FindFirstChild("RightGrip")
    if g then return g end
    for _, v in ipairs(rh:GetChildren()) do
        if v:IsA("Motor6D") or v:IsA("Weld") then return v end
    end
end

local function onToolAdded(tool)
    if not tool:IsA("Tool") then return end
    task.wait()
    local g = getGrip()
    if not g then return end
    if not origCF[tool.Name] then origCF[tool.Name] = g.C0 end
    if savedCF[tool.Name] then g.C0 = savedCF[tool.Name] end
end

if LocalPlayer.Character then
    LocalPlayer.Character.ChildAdded:Connect(onToolAdded)
end
LocalPlayer.CharacterAdded:Connect(function(ch)
    ch.ChildAdded:Connect(onToolAdded)
end)

local function rotate(x, y, z)
    local g = getGrip(); local t = getTool()
    if g then
        g.C0 = g.C0 * CFrame.Angles(x, y, z)
        if t then savedCF[t.Name] = g.C0 end
    end
end
local function translate(v)
    local g = getGrip(); local t = getTool()
    if g then
        g.C0 = g.C0 + v
        if t then savedCF[t.Name] = g.C0 end
    end
end

