local comActive, comWeightOn = false, false
local comConn, comCharConn = nil, nil
local lastLook = nil

local function applyWeight(char)
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end
    local old = char:FindFirstChild("CoMWeight_Object")
    if old then old:Destroy() end
    local part = Instance.new("Part")
    part.Name = "CoMWeight_Object"
    part.Size = Vector3.new(1,1,1)
    part.Transparency = 1
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Massless = false
    part.Parent = char
    local weld = Instance.new("Weld")
    weld.Part0 = hrp
    weld.Part1 = part
    weld.C0 = CFrame.new(0, 0, 5.2)
    weld.Parent = part
    part.CustomPhysicalProperties = PhysicalProperties.new(20.6, 0.3, 0.5)
end

local function setComToggle(active)
    comWeightOn = active
    TweenService:Create(comToggle, TweenInfo.new(0.2), {
        BackgroundColor3 = active and T.Success or T.Card
    }):Play()
end

local function toggleWeight()
    local char = LocalPlayer.Character
    if not char then return end
    local existing = char:FindFirstChild("CoMWeight_Object")
    if existing or comWeightOn then
        if existing then existing:Destroy() end
        setComToggle(false)
    else
        applyWeight(char)
        setComToggle(true)
    end
end

comToggle.MouseButton1Click:Connect(toggleWeight)

local function comLoop()
    local char = LocalPlayer.Character
    if not char then task.wait(0.1); return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local cam = Workspace.CurrentCamera
    if not (hrp and hum and cam) then task.wait(0.1); return end

    local look = cam.CFrame.LookVector
    local dt = math.max(RunService.RenderStepped:Wait(), 0.001)
    local turnRate = (look - lastLook).Magnitude / dt
    lastLook = look

    local moveDir = hum.MoveDirection
    if moveDir.Magnitude >= 0.1 and moveDir:Dot(look) < -0.35 and turnRate > 8 then
        local boost = math.clamp(turnRate * 1.8, 0, 90) * speedValue
        hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity
            + moveDir.Unit * boost * dt * 55
    end
end

local function startComLoop()
    if comConn then comConn:Disconnect() end
    lastLook = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.LookVector or Vector3.new(0,0,-1)
    comConn = RunService.Heartbeat:Connect(comLoop)
end

local function stopComLoop()
    if comConn then comConn:Disconnect(); comConn = nil end
end

local function setCoMEnabled(enabled)
    comActive = enabled
    if enabled then
        startComLoop()
        local ch = LocalPlayer.Character
        if ch then applyWeight(ch) end
        setComToggle(true)
        comFrame.Visible = true
    else
        stopComLoop()
        local ch = LocalPlayer.Character
        if ch then
            local w = ch:FindFirstChild("CoMWeight_Object")
            if w then w:Destroy() end
        end
        setComToggle(false)
        comFrame.Visible = false
    end
end

comClose.MouseButton1Click:Connect(function()
    setCoMEnabled(false)
    setSpeed(false, "Speed Tawa: Desativado")
end)

